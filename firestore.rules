        incoming().updatedAt == request.time && (
          isAdmin() ||
          (incoming().guardianUid == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().reviewedByUid == '')
        );
      allow update: if isSignedIn() && isValidId(requestId) && isValidGuardianLinkRequest(incoming()) &&
        (incoming().authorId == existing().authorId || (isAdmin() && incoming().authorId == request.auth.uid)) &&
        incoming().guardianUid == existing().guardianUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }

    match /accountInvitations/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        hasRole(['super_admin', 'muhtamim', 'staff']) ||
        existing().redeemedByUid == request.auth.uid ||
        existing().status == 'pending_activation'
      );
      allow list: if isSignedIn() && (
        existing().redeemedByUid == request.auth.uid ||
        existing().authorId == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().status in ['pending_activation', 'activated', 'revoked', 'expired'])
      );
      allow create: if isSignedIn() && isValidId(inviteId) && isValidAccountInvitation(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          hasRole(['super_admin']) ||
          (hasRole(['muhtamim']) && incoming().targetRole in ['teacher', 'accountant', 'residential_supervisor', 'staff', 'student', 'guardian'])
        );
      allow update: if isSignedIn() && isValidId(inviteId) && isValidAccountInvitation(incoming()) &&
        (incoming().authorId == existing().authorId || (isAdmin() && incoming().authorId == request.auth.uid)) &&
        incoming().invitationCode == existing().invitationCode &&
        incoming().studentId == existing().studentId &&
        incoming().targetRole == existing().targetRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          hasRole(['super_admin']) ||
          (hasRole(['muhtamim']) && existing().targetRole != 'muhtamim') ||
          (existing().status == 'pending_activation' &&
            incoming().status == 'activated' &&
            incoming().redeemedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'redeemedByUid', 'redeemedAt', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(inviteId) && hasRole(['super_admin']);
    }

    match /systemBootstrap/{lockId} {
      allow get: if isSignedIn() && isValidId(lockId);
      allow list: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().isProvisioned == true)
      );
      allow create: if isSignedIn() && isValidId(lockId) && lockId == 'super_admin_lock' &&
        !exists(/databases/$(database)/documents/systemBootstrap/super_admin_lock) &&
        isValidSuperAdminBootstrapLock(incoming()) &&
        incoming().isProvisioned == true &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isBootstrapSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().actorRole in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'])
      );
      allow create: if isSignedIn() && isValidId(logId) && isValidAdminAuditLog(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
