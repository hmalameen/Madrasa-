    function isValidAccountInvitation(data) {
      return data.keys().hasAll([
        'invitationCode', 'targetRole', 'applicationId', 'studentId',
        'admissionNo', 'studentNameBn', 'recipientName', 'recipientPhone',
        'recipientEmail', 'activationUrl', 'status', 'provisioningMode',
        'requiresPasswordChangeOnFirstLogin', 'issuedByUid', 'issuedAt',
        'redeemedByUid', 'redeemedAt', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().size() >= 20 &&
      data.keys().size() <= 28 &&
      (!('issuedByRole' in data) || (data.issuedByRole is string && data.issuedByRole.size() <= 30 && data.issuedByRole in ['super_admin', 'muhtamim'])) &&
      (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 60)) &&
      (!('staffId' in data) || (data.staffId is string && data.staffId.size() <= 128)) &&
      (!('employeeCode' in data) || (data.employeeCode is string && data.employeeCode.size() <= 80)) &&
      (!('designation' in data) || (data.designation is string && data.designation.size() <= 200)) &&
      (!('assignedDepartment' in data) || (data.assignedDepartment is string && data.assignedDepartment.size() <= 40 && data.assignedDepartment in ['hifz', 'qawmi', 'general', 'administration', 'boarding'])) &&
      (!('assignedClasses' in data) || (data.assignedClasses is string && data.assignedClasses.size() <= 300)) &&
      (!('assignedSubjects' in data) || (data.assignedSubjects is string && data.assignedSubjects.size() <= 300)) &&
      data.invitationCode is string && data.invitationCode.size() >= 6 && data.invitationCode.size() <= 100 && data.invitationCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.targetRole is string && data.targetRole.size() <= 40 && data.targetRole in ['muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'staff', 'student', 'guardian'] &&
      data.applicationId is string && data.applicationId.size() >= 1 && data.applicationId.size() <= 128 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 300 &&
      data.recipientPhone is string && data.recipientPhone.size() >= 5 && data.recipientPhone.size() <= 80 &&
      data.recipientEmail is string && data.recipientEmail.size() <= 250 &&
      data.activationUrl is string && data.activationUrl.size() >= 5 && data.activationUrl.size() <= 500 &&
      data.status is string && data.status.size() <= 40 && data.status in ['pending_activation', 'activated', 'revoked', 'expired'] &&
      data.provisioningMode is string && data.provisioningMode.size() <= 50 && data.provisioningMode in ['single_use_activation_link'] &&
      data.requiresPasswordChangeOnFirstLogin is bool &&
      data.issuedByUid is string && data.issuedByUid.size() >= 1 && data.issuedByUid.size() <= 128 &&
      data.issuedAt is string && data.issuedAt.size() >= 4 && data.issuedAt.size() <= 60 &&
      data.redeemedByUid is string && data.redeemedByUid.size() <= 128 &&
      data.redeemedAt is string && data.redeemedAt.size() <= 60 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSuperAdminBootstrapLock(data) {
      return data.keys().hasAll([
        'lockId', 'isProvisioned', 'superAdminUid', 'superAdminEmail',
        'superAdminName', 'provisionedAt', 'bootstrapMethod',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'lockId', 'isProvisioned', 'superAdminUid', 'superAdminEmail',
        'superAdminName', 'provisionedAt', 'bootstrapMethod',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.lockId is string && data.lockId.size() <= 40 && data.lockId in ['super_admin_lock'] &&
      data.isProvisioned is bool &&
      data.superAdminUid is string && data.superAdminUid.size() >= 1 && data.superAdminUid.size() <= 128 &&
      data.superAdminEmail is string && data.superAdminEmail.size() >= 3 && data.superAdminEmail.size() <= 200 &&
      data.superAdminName is string && data.superAdminName.size() >= 1 && data.superAdminName.size() <= 200 &&
      data.provisionedAt is string && data.provisionedAt.size() >= 4 && data.provisionedAt.size() <= 60 &&
      data.bootstrapMethod is string && data.bootstrapMethod.size() <= 50 && data.bootstrapMethod in ['verified_owner_session', 'one_time_setup_token'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
        'action', 'actorUid', 'actorEmail', 'actorRole',
        'targetUid', 'targetEmail', 'targetRole',
        'summaryBn', 'timestamp',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'action', 'actorUid', 'actorEmail', 'actorRole',
        'targetUid', 'targetEmail', 'targetRole',
        'summaryBn', 'timestamp',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.action is string && data.action.size() <= 60 && data.action in [
        'super_admin_bootstrapped', 'muhtamim_invited', 'staff_invited',
        'invitation_activated', 'invitation_revoked', 'user_role_updated',
        'user_status_suspended', 'user_status_activated', 'admission_approved'
      ] &&
      data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
      data.actorEmail is string && data.actorEmail.size() <= 200 &&
      data.actorRole is string && data.actorRole.size() <= 40 && data.actorRole in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'] &&
      data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
      data.targetEmail is string && data.targetEmail.size() <= 200 &&
      data.targetRole is string && data.targetRole.size() <= 40 && data.targetRole in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'] &&
      data.summaryBn is string && data.summaryBn.size() >= 1 && data.summaryBn.size() <= 600 &&
      data.timestamp is string && data.timestamp.size() >= 4 && data.timestamp.size() <= 60 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || (isBootstrapSuperAdmin() && existing().uid is string));
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (request.auth.uid == userId && incoming().uid == request.auth.uid && (
            (isBootstrapSuperAdmin() && incoming().role == 'super_admin' && incoming().status == 'active') ||
            (incoming().role in ['guardian', 'student'] && incoming().status == 'pending')
          )) ||
          isAdmin()
        );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          hasRole(['super_admin']) ||
          (hasRole(['muhtamim']) && existing().role != 'super_admin' && existing().role != 'muhtamim' && incoming().role != 'super_admin' && incoming().role != 'muhtamim') ||
          (request.auth.uid == userId && existing().status != 'suspended' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().linkedStudentIds == existing().linkedStudentIds &&
            incoming().assignedClasses == existing().assignedClasses &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(userId) && hasRole(['super_admin']);
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (
        existing().guardianUid == request.auth.uid ||
        isLinkedGuardianOf(studentId) ||
        isLinkedStudentOf(studentId) ||
        hasRole(['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'staff'])
      );
      allow list: if isSignedIn() && (
        existing().guardianUid == request.auth.uid ||
        existing().authorId == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().status in ['active', 'on_leave', 'graduated', 'transferred'])
      );
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasRole(['super_admin', 'muhtamim', 'staff']);
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) &&
        (incoming().authorId == existing().authorId || (isAdmin() && incoming().authorId == request.auth.uid)) &&
        incoming().admissionNo == existing().admissionNo &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().status != 'graduated' && hasRole(['staff', 'residential_supervisor']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'className', 'rollNo', 'guardianPhone', 'photoUrl', 'residentialStatus',
              'dormitoryRoom', 'status', 'updatedAt'
            ]))
        );
      allow delete: if isSignedIn() && isValidId(studentId) && isAdmin();
    }

    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && (
        existing().authorId == request.auth.uid ||
        hasRole(['super_admin', 'muhtamim', 'accountant'])
      );
      allow list: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().status in ['active', 'on_leave', 'resigned'])
      );
      allow create: if isSignedIn() && isValidId(staffId) && isValidStaffMember(incoming()) &&
