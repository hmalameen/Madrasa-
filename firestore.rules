rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'hmalameenemob@gmail.com';
    }

    function userProfileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(allowedRoles) {
      return isSignedIn() && (
        isBootstrapSuperAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          userProfileData().status == 'active' &&
          userProfileData().role in allowedRoles
        )
      );
    }

    function isAdmin() {
      return hasRole(['super_admin', 'muhtamim']);
    }

    function isLinkedGuardianOf(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userProfileData().status == 'active' &&
        userProfileData().role == 'guardian' &&
        userProfileData().linkedStudentIds.split(',').hasAny([studentId]);
    }

    function isLinkedStudentOf(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userProfileData().status == 'active' &&
        userProfileData().role == 'student' &&
        userProfileData().linkedStudentIds == studentId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'status',
        'linkedStudentIds', 'assignedClasses', 'phone', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'status',
        'linkedStudentIds', 'assignedClasses', 'phone', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 250 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 250 &&
      data.role in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'] &&
      data.status in ['active', 'pending', 'suspended'] &&
      data.linkedStudentIds is string && data.linkedStudentIds.size() <= 800 &&
      data.assignedClasses is string && data.assignedClasses.size() <= 600 &&
      data.phone is string && data.phone.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
        'admissionNo', 'nameBn', 'nameEn', 'nameAr', 'department', 'className', 'rollNo',
        'dateOfBirth', 'bloodGroup', 'admissionDate', 'guardianName', 'guardianPhone',
        'guardianRelation', 'guardianUid', 'residentialStatus', 'dormitoryRoom',
        'monthlyFeeBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'admissionNo', 'nameBn', 'nameEn', 'nameAr', 'department', 'className', 'rollNo',
        'dateOfBirth', 'bloodGroup', 'admissionDate', 'guardianName', 'guardianPhone',
        'guardianRelation', 'guardianUid', 'studentUid', 'photoUrl', 'applicationId',
        'residentialStatus', 'dormitoryRoom', 'monthlyFeeBdt', 'status',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 300 &&
      data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 300 &&
      data.nameAr is string && data.nameAr.size() <= 300 &&
      data.department in ['hifz', 'qawmi', 'general'] &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 250 &&
      data.rollNo is number && data.rollNo >= 1 && data.rollNo <= 999999 &&
      data.guardianName is string && data.guardianName.size() >= 1 && data.guardianName.size() <= 300 &&
      data.guardianPhone is string && data.guardianPhone.size() >= 5 && data.guardianPhone.size() <= 80 &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.residentialStatus in ['residential', 'day_scholar'] &&
      data.monthlyFeeBdt is number && data.monthlyFeeBdt >= 0 && data.monthlyFeeBdt <= 5000000 &&
      data.status in ['active', 'on_leave', 'graduated', 'transferred'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll([
        'employeeCode', 'nameBn', 'nameEn', 'designation', 'role', 'department',
        'assignedClasses', 'phone', 'qualification', 'joiningDate', 'basicSalaryBdt',
        'houseAllowanceBdt', 'medicalAllowanceBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'employeeCode', 'nameBn', 'nameEn', 'designation', 'role', 'department',
        'assignedClasses', 'phone', 'qualification', 'joiningDate', 'basicSalaryBdt',
        'houseAllowanceBdt', 'medicalAllowanceBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 100 &&
      data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 300 &&
      data.role in ['muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'staff'] &&
      data.department in ['hifz', 'qawmi', 'general', 'administration', 'boarding'] &&
      data.basicSalaryBdt is number && data.basicSalaryBdt >= 0 &&
      data.houseAllowanceBdt is number && data.houseAllowanceBdt >= 0 &&
      data.medicalAllowanceBdt is number && data.medicalAllowanceBdt >= 0 &&
      data.status in ['active', 'on_leave', 'resigned'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'status', 'guardianUid', 'remarks', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'status', 'guardianUid', 'remarks', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.date is string && data.date.size() >= 4 && data.date.size() <= 40 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.department in ['hifz', 'qawmi', 'general'] &&
      data.status in ['present', 'absent', 'late', 'leave'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExamResult(data) {
      return data.keys().hasAll([
        'examName', 'academicYear', 'studentId', 'studentNameBn', 'admissionNo',
        'className', 'department', 'subjectName', 'marksObtained', 'fullMarks',
        'grade', 'isPublished', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'examName', 'academicYear', 'studentId', 'studentNameBn', 'admissionNo',
        'className', 'department', 'subjectName', 'marksObtained', 'fullMarks',
        'grade', 'isPublished', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.examName is string && data.examName.size() >= 1 && data.examName.size() <= 300 &&
      data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 60 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.department in ['hifz', 'qawmi', 'general'] &&
      data.marksObtained is number && data.marksObtained >= 0 && data.marksObtained <= 1000 &&
      data.fullMarks is number && data.fullMarks >= 1 && data.fullMarks <= 1000 &&
      data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 80 &&
      data.isPublished is bool &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFeeInvoice(data) {
      return data.keys().hasAll([
        'receiptNo', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'feeType', 'billingMonth', 'amountDueBdt', 'amountPaidBdt', 'paymentMethod',
        'transactionRef', 'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'receiptNo', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'feeType', 'billingMonth', 'amountDueBdt', 'amountPaidBdt', 'paymentMethod',
        'transactionRef', 'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.receiptNo is string && data.receiptNo.size() >= 1 && data.receiptNo.size() <= 100 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.feeType in ['monthly_tuition', 'boarding_mess', 'admission_fee', 'exam_fee', 'generator_utility'] &&
      data.amountDueBdt is number && data.amountDueBdt >= 0 &&
      data.amountPaidBdt is number && data.amountPaidBdt >= 0 &&
      data.paymentMethod in ['cash', 'bkash', 'nagad', 'bank_transfer', 'unpaid'] &&
      data.status in ['paid', 'partial', 'unpaid'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data) {
      return data.keys().hasAll([
        'voucherNo', 'title', 'category', 'amountBdt', 'expenseDate',
        'approvedBy', 'notes', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'voucherNo', 'title', 'category', 'amountBdt', 'expenseDate',
        'approvedBy', 'notes', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.voucherNo is string && data.voucherNo.size() >= 1 && data.voucherNo.size() <= 100 &&
      data.category in ['boarding_food', 'utilities', 'maintenance', 'stationery', 'events'] &&
      data.amountBdt is number && data.amountBdt >= 1 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHifzProgressLog(data) {
      return data.keys().hasAll([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'paraNumber',
        'sabaqSurahAndAyat', 'sabaqLines', 'sabqiPara', 'manzilPara',
        'tajweedRating', 'teacherComment', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'paraNumber',
        'sabaqSurahAndAyat', 'sabaqLines', 'sabqiPara', 'manzilPara',
        'tajweedRating', 'teacherComment', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.paraNumber is number && data.paraNumber >= 1 && data.paraNumber <= 30 &&
      data.sabaqLines is number && data.sabaqLines >= 0 && data.sabaqLines <= 500 &&
      data.tajweedRating in ['mumtaz', 'jayyid_jiddan', 'jayyid', 'needs_revision'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidResidentialLeave(data) {
      return data.keys().hasAll([
        'studentId', 'studentNameBn', 'admissionNo', 'dormitoryRoom', 'reason',
        'departureDate', 'expectedReturnDate', 'actualReturnDate', 'accompaniedBy',
        'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentId', 'studentNameBn', 'admissionNo', 'dormitoryRoom', 'reason',
        'departureDate', 'expectedReturnDate', 'actualReturnDate', 'accompaniedBy',
        'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.status in ['pending', 'approved', 'returned', 'rejected'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPayrollRecord(data) {
      return data.keys().hasAll([
        'staffId', 'staffNameBn', 'employeeCode', 'designation', 'salaryMonth',
        'basicSalaryBdt', 'allowancesBdt', 'deductionsBdt', 'netPayableBdt',
        'status', 'paymentDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'staffId', 'staffNameBn', 'employeeCode', 'designation', 'salaryMonth',
        'basicSalaryBdt', 'allowancesBdt', 'deductionsBdt', 'netPayableBdt',
        'status', 'paymentDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
      data.netPayableBdt is number && data.netPayableBdt >= 0 &&
      data.status in ['paid', 'pending'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidNotice(data) {
      return data.keys().hasAll([
        'titleBn', 'titleEn', 'contentBn', 'targetAudience', 'targetClass',
        'priority', 'publishDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'titleBn', 'titleEn', 'contentBn', 'targetAudience', 'targetClass',
        'priority', 'publishDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 400 &&
      data.targetAudience in ['all', 'guardians', 'teachers', 'residential', 'students'] &&
      data.priority in ['normal', 'important', 'urgent'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInstitutionSettings(data) {
      return data.keys().hasAll([
        'institutionNameBn', 'institutionNameEn', 'institutionNameAr',
        'academicYear', 'hijriYear', 'addressBn', 'phone', 'email',
        'defaultLanguage', 'activeDepartments', 'gradingSystem',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'institutionNameBn', 'institutionNameEn', 'institutionNameAr',
        'academicYear', 'hijriYear', 'addressBn', 'phone', 'email',
        'defaultLanguage', 'activeDepartments', 'gradingSystem',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.institutionNameBn is string && data.institutionNameBn.size() >= 1 && data.institutionNameBn.size() <= 300 &&
      data.institutionNameEn is string && data.institutionNameEn.size() >= 1 && data.institutionNameEn.size() <= 300 &&
      data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 100 &&
      data.defaultLanguage in ['bn', 'en', 'ar'] &&
      data.gradingSystem is string && data.gradingSystem.size() <= 800 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBannerSlide(data) {
      return data.keys().hasAll([
        'category', 'badgeBn', 'badgeEn', 'badgeAr',
        'titleBn', 'titleEn', 'titleAr',
        'descriptionBn', 'descriptionEn', 'descriptionAr',
        'metaDate', 'ctaModule', 'ctaLabelBn', 'ctaLabelEn', 'ctaLabelAr',
        'theme', 'isActive', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'category', 'badgeBn', 'badgeEn', 'badgeAr',
        'titleBn', 'titleEn', 'titleAr',
        'descriptionBn', 'descriptionEn', 'descriptionAr',
        'metaDate', 'ctaModule', 'ctaLabelBn', 'ctaLabelEn', 'ctaLabelAr',
        'theme', 'isActive', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.category in ['academic', 'exam', 'admission', 'event'] &&
      data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 400 &&
      data.theme in ['emerald', 'navy', 'ivory'] &&
      data.isActive is bool &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudyDiaryEntry(data) {
      return data.keys().hasAll([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'subjectName', 'lessonCovered', 'homeworkAssigned',
        'dueDate', 'completionStatus', 'teacherFeedback', 'learningGoal',
        'visibleToGuardian', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'subjectName', 'lessonCovered', 'homeworkAssigned',
        'dueDate', 'completionStatus', 'teacherFeedback', 'learningGoal',
        'visibleToGuardian', 'guardianUid', 'studentUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.department in ['hifz', 'qawmi', 'general'] &&
      data.completionStatus in ['pending', 'completed', 'needs_revision'] &&
      data.visibleToGuardian is bool &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGuardianInquiry(data) {
      return data.keys().hasAll([
        'studentId', 'studentNameBn', 'admissionNo', 'guardianUid',
        'guardianName', 'subject', 'message', 'teacherReply',
        'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentId', 'studentNameBn', 'admissionNo', 'guardianUid',
        'guardianName', 'subject', 'message', 'teacherReply',
        'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
      data.status in ['open', 'replied', 'resolved'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdmissionApplication(data) {
      return data.keys().hasAll([
        'referenceNo', 'nameBn', 'nameEn', 'department', 'requestedClass',
        'guardianName', 'guardianPhone', 'residentialStatus', 'status',
        'assignedStudentId', 'assignedAdmissionNo', 'reviewedByUid',
        'applicantUid', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().size() >= 17 && data.keys().size() <= 50 &&
      data.referenceNo is string && data.referenceNo.size() >= 4 && data.referenceNo.size() <= 100 &&
      data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 300 &&
      data.department in ['hifz', 'qawmi', 'general'] &&
      data.residentialStatus in ['residential', 'day_scholar'] &&
      data.status in ['pending', 'under_review', 'needs_correction', 'approved', 'rejected'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGuardianLinkRequest(data) {
      return data.keys().hasAll([
        'guardianUid', 'guardianName', 'guardianPhone', 'guardianEmail',
        'requestedAdmissionNo', 'requestedStudentNameBn', 'relationship',
        'matchedStudentId', 'status', 'adminNotes', 'requestedDate',
        'reviewedDate', 'reviewedByUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'guardianUid', 'guardianName', 'guardianPhone', 'guardianEmail',
        'requestedAdmissionNo', 'requestedStudentNameBn', 'relationship',
        'matchedStudentId', 'status', 'adminNotes', 'requestedDate',
        'reviewedDate', 'reviewedByUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.guardianUid is string && data.guardianUid.size() >= 1 && data.guardianUid.size() <= 128 &&
      data.requestedAdmissionNo is string && data.requestedAdmissionNo.size() >= 1 && data.requestedAdmissionNo.size() <= 100 &&
      data.status in ['pending', 'approved', 'rejected'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAccountInvitation(data) {
      return data.keys().hasAll([
        'invitationCode', 'targetRole', 'applicationId', 'studentId',
        'admissionNo', 'studentNameBn', 'recipientName', 'recipientPhone',
        'recipientEmail', 'activationUrl', 'status', 'provisioningMode',
        'requiresPasswordChangeOnFirstLogin', 'issuedByUid', 'issuedAt',
        'redeemedByUid', 'redeemedAt', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().size() >= 20 && data.keys().size() <= 30 &&
      data.invitationCode is string && data.invitationCode.size() >= 6 && data.invitationCode.size() <= 100 &&
      data.targetRole in ['muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'staff', 'student', 'guardian'] &&
      data.status in ['pending_activation', 'activated', 'revoked', 'expired'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSuperAdminBootstrapLock(data) {
      return data.keys().hasAll([
        'lockId', 'isProvisioned', 'superAdminUid', 'superAdminEmail',
        'superAdminName', 'provisionedAt', 'bootstrapMethod',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'lockId', 'isProvisioned', 'superAdminUid', 'superAdminEmail',
        'superAdminName', 'provisionedAt', 'bootstrapMethod',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.lockId == 'super_admin_lock' &&
      data.isProvisioned is bool &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
        'action', 'actorUid', 'actorEmail', 'actorRole',
        'targetUid', 'targetEmail', 'targetRole',
        'summaryBn', 'timestamp',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'action', 'actorUid', 'actorEmail', 'actorRole',
        'targetUid', 'targetEmail', 'targetRole',
        'summaryBn', 'timestamp',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.actorRole in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid ||
        (isBootstrapSuperAdmin() && existing().status in ['active', 'pending', 'suspended'])
      );
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (request.auth.uid == userId && incoming().uid == request.auth.uid && (
            (isBootstrapSuperAdmin() && incoming().role == 'super_admin' && incoming().status == 'active') ||
