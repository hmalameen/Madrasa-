rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'hmalameenemob@gmail.com';
    }

    function hasRole(allowedRoles) {
      return isSignedIn() && (
        isBootstrapSuperAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in allowedRoles
        )
      );
    }

    function isAdmin() {
      return hasRole(['super_admin', 'muhtamim']);
    }

    function isLinkedGuardianOf(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guardian' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds.split(',').hasAny([studentId]);
    }

    function isLinkedStudentOf(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds == studentId;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'status',
        'linkedStudentIds', 'assignedClasses', 'phone', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'status',
        'linkedStudentIds', 'assignedClasses', 'phone', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 250 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 250 &&
      data.role is string && data.role.size() <= 60 && data.role in ['super_admin', 'muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'guardian', 'student', 'staff'] &&
      data.status is string && data.status.size() <= 40 && data.status in ['active', 'pending', 'suspended'] &&
      data.linkedStudentIds is string && data.linkedStudentIds.size() <= 800 &&
      data.assignedClasses is string && data.assignedClasses.size() <= 600 &&
      data.phone is string && data.phone.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
        'admissionNo', 'nameBn', 'nameEn', 'nameAr', 'department', 'className', 'rollNo',
        'dateOfBirth', 'bloodGroup', 'admissionDate', 'guardianName', 'guardianPhone',
        'guardianRelation', 'guardianUid', 'residentialStatus', 'dormitoryRoom',
        'monthlyFeeBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'admissionNo', 'nameBn', 'nameEn', 'nameAr', 'department', 'className', 'rollNo',
        'dateOfBirth', 'bloodGroup', 'admissionDate', 'guardianName', 'guardianPhone',
        'guardianRelation', 'guardianUid', 'studentUid', 'photoUrl', 'applicationId', 'residentialStatus', 'dormitoryRoom',
        'monthlyFeeBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 && data.admissionNo.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 300 &&
      data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 300 &&
      data.nameAr is string && data.nameAr.size() <= 300 &&
      data.department is string && data.department.size() <= 50 && data.department in ['hifz', 'qawmi', 'general'] &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 250 &&
      data.rollNo is number && data.rollNo >= 1 && data.rollNo <= 999999 &&
      data.dateOfBirth is string && data.dateOfBirth.size() <= 60 &&
      data.bloodGroup is string && data.bloodGroup.size() <= 30 &&
      data.admissionDate is string && data.admissionDate.size() >= 4 && data.admissionDate.size() <= 60 &&
      data.guardianName is string && data.guardianName.size() >= 1 && data.guardianName.size() <= 300 &&
      data.guardianPhone is string && data.guardianPhone.size() >= 5 && data.guardianPhone.size() <= 80 &&
      data.guardianRelation is string && data.guardianRelation.size() <= 150 &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      (!('studentUid' in data) || (data.studentUid is string && data.studentUid.size() <= 128)) &&
      (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 75000)) &&
      (!('applicationId' in data) || (data.applicationId is string && data.applicationId.size() <= 128)) &&
      data.residentialStatus is string && data.residentialStatus.size() <= 40 && data.residentialStatus in ['residential', 'day_scholar'] &&
      data.dormitoryRoom is string && data.dormitoryRoom.size() <= 250 &&
      data.monthlyFeeBdt is number && data.monthlyFeeBdt >= 0 && data.monthlyFeeBdt <= 5000000 &&
      data.status is string && data.status.size() <= 40 && data.status in ['active', 'on_leave', 'graduated', 'transferred'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll([
        'employeeCode', 'nameBn', 'nameEn', 'designation', 'role', 'department',
        'assignedClasses', 'phone', 'qualification', 'joiningDate', 'basicSalaryBdt',
        'houseAllowanceBdt', 'medicalAllowanceBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'employeeCode', 'nameBn', 'nameEn', 'designation', 'role', 'department',
        'assignedClasses', 'phone', 'qualification', 'joiningDate', 'basicSalaryBdt',
        'houseAllowanceBdt', 'medicalAllowanceBdt', 'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 100 && data.employeeCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 300 &&
      data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 300 &&
      data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 300 &&
      data.role is string && data.role.size() <= 60 && data.role in ['muhtamim', 'teacher', 'accountant', 'residential_supervisor', 'staff'] &&
      data.department is string && data.department.size() <= 60 && data.department in ['hifz', 'qawmi', 'general', 'administration', 'boarding'] &&
      data.assignedClasses is string && data.assignedClasses.size() <= 500 &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 80 &&
      data.qualification is string && data.qualification.size() <= 400 &&
      data.joiningDate is string && data.joiningDate.size() <= 60 &&
      data.basicSalaryBdt is number && data.basicSalaryBdt >= 0 && data.basicSalaryBdt <= 5000000 &&
      data.houseAllowanceBdt is number && data.houseAllowanceBdt >= 0 && data.houseAllowanceBdt <= 2000000 &&
      data.medicalAllowanceBdt is number && data.medicalAllowanceBdt >= 0 && data.medicalAllowanceBdt <= 2000000 &&
      data.status is string && data.status.size() <= 40 && data.status in ['active', 'on_leave', 'resigned'] &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'status', 'guardianUid', 'remarks', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'department', 'status', 'guardianUid', 'remarks', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.date is string && data.date.size() >= 4 && data.date.size() <= 40 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 250 &&
      data.department is string && data.department.size() <= 50 && data.department in ['hifz', 'qawmi', 'general'] &&
      data.status is string && data.status.size() <= 30 && data.status in ['present', 'absent', 'late', 'leave'] &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.remarks is string && data.remarks.size() <= 600 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExamResult(data) {
      return data.keys().hasAll([
        'examName', 'academicYear', 'studentId', 'studentNameBn', 'admissionNo',
        'className', 'department', 'subjectName', 'marksObtained', 'fullMarks',
        'grade', 'isPublished', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'examName', 'academicYear', 'studentId', 'studentNameBn', 'admissionNo',
        'className', 'department', 'subjectName', 'marksObtained', 'fullMarks',
        'grade', 'isPublished', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.examName is string && data.examName.size() >= 1 && data.examName.size() <= 300 &&
      data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 60 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 250 &&
      data.department is string && data.department.size() <= 50 && data.department in ['hifz', 'qawmi', 'general'] &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 300 &&
      data.marksObtained is number && data.marksObtained >= 0 && data.marksObtained <= 1000 &&
      data.fullMarks is number && data.fullMarks >= 1 && data.fullMarks <= 1000 &&
      data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 80 &&
      data.isPublished is bool &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFeeInvoice(data) {
      return data.keys().hasAll([
        'receiptNo', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'feeType', 'billingMonth', 'amountDueBdt', 'amountPaidBdt', 'paymentMethod',
        'transactionRef', 'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'receiptNo', 'studentId', 'studentNameBn', 'admissionNo', 'className',
        'feeType', 'billingMonth', 'amountDueBdt', 'amountPaidBdt', 'paymentMethod',
        'transactionRef', 'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.receiptNo is string && data.receiptNo.size() >= 1 && data.receiptNo.size() <= 100 && data.receiptNo.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 250 &&
      data.feeType is string && data.feeType.size() <= 60 && data.feeType in ['monthly_tuition', 'boarding_mess', 'admission_fee', 'exam_fee', 'generator_utility'] &&
      data.billingMonth is string && data.billingMonth.size() >= 2 && data.billingMonth.size() <= 120 &&
      data.amountDueBdt is number && data.amountDueBdt >= 0 && data.amountDueBdt <= 10000000 &&
      data.amountPaidBdt is number && data.amountPaidBdt >= 0 && data.amountPaidBdt <= 10000000 &&
      data.paymentMethod is string && data.paymentMethod.size() <= 40 && data.paymentMethod in ['cash', 'bkash', 'nagad', 'bank_transfer', 'unpaid'] &&
      data.transactionRef is string && data.transactionRef.size() <= 150 &&
      data.status is string && data.status.size() <= 30 && data.status in ['paid', 'partial', 'unpaid'] &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data) {
      return data.keys().hasAll([
        'voucherNo', 'title', 'category', 'amountBdt', 'expenseDate',
        'approvedBy', 'notes', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'voucherNo', 'title', 'category', 'amountBdt', 'expenseDate',
        'approvedBy', 'notes', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.voucherNo is string && data.voucherNo.size() >= 1 && data.voucherNo.size() <= 100 && data.voucherNo.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
      data.category is string && data.category.size() <= 60 && data.category in ['boarding_food', 'utilities', 'maintenance', 'stationery', 'events'] &&
      data.amountBdt is number && data.amountBdt >= 1 && data.amountBdt <= 50000000 &&
      data.expenseDate is string && data.expenseDate.size() >= 4 && data.expenseDate.size() <= 60 &&
      data.approvedBy is string && data.approvedBy.size() <= 250 &&
      data.notes is string && data.notes.size() <= 800 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHifzProgressLog(data) {
      return data.keys().hasAll([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'paraNumber',
        'sabaqSurahAndAyat', 'sabaqLines', 'sabqiPara', 'manzilPara',
        'tajweedRating', 'teacherComment', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'date', 'studentId', 'studentNameBn', 'admissionNo', 'paraNumber',
        'sabaqSurahAndAyat', 'sabaqLines', 'sabqiPara', 'manzilPara',
        'tajweedRating', 'teacherComment', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.date is string && data.date.size() >= 4 && data.date.size() <= 40 &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.paraNumber is number && data.paraNumber >= 1 && data.paraNumber <= 30 &&
      data.sabaqSurahAndAyat is string && data.sabaqSurahAndAyat.size() >= 1 && data.sabaqSurahAndAyat.size() <= 300 &&
      data.sabaqLines is number && data.sabaqLines >= 0 && data.sabaqLines <= 500 &&
      data.sabqiPara is string && data.sabqiPara.size() <= 250 &&
      data.manzilPara is string && data.manzilPara.size() <= 250 &&
      data.tajweedRating is string && data.tajweedRating.size() <= 60 && data.tajweedRating in ['mumtaz', 'jayyid_jiddan', 'jayyid', 'needs_revision'] &&
      data.teacherComment is string && data.teacherComment.size() <= 800 &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidResidentialLeave(data) {
      return data.keys().hasAll([
        'studentId', 'studentNameBn', 'admissionNo', 'dormitoryRoom', 'reason',
        'departureDate', 'expectedReturnDate', 'actualReturnDate', 'accompaniedBy',
        'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentId', 'studentNameBn', 'admissionNo', 'dormitoryRoom', 'reason',
        'departureDate', 'expectedReturnDate', 'actualReturnDate', 'accompaniedBy',
        'status', 'guardianUid', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentNameBn is string && data.studentNameBn.size() >= 1 && data.studentNameBn.size() <= 300 &&
      data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 100 &&
      data.dormitoryRoom is string && data.dormitoryRoom.size() <= 250 &&
      data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 600 &&
      data.departureDate is string && data.departureDate.size() >= 4 && data.departureDate.size() <= 60 &&
      data.expectedReturnDate is string && data.expectedReturnDate.size() >= 4 && data.expectedReturnDate.size() <= 60 &&
      data.actualReturnDate is string && data.actualReturnDate.size() <= 60 &&
      data.accompaniedBy is string && data.accompaniedBy.size() <= 250 &&
      data.status is string && data.status.size() <= 40 && data.status in ['pending', 'approved', 'returned', 'rejected'] &&
      data.guardianUid is string && data.guardianUid.size() <= 128 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPayrollRecord(data) {
      return data.keys().hasAll([
        'staffId', 'staffNameBn', 'employeeCode', 'designation', 'salaryMonth',
        'basicSalaryBdt', 'allowancesBdt', 'deductionsBdt', 'netPayableBdt',
        'status', 'paymentDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'staffId', 'staffNameBn', 'employeeCode', 'designation', 'salaryMonth',
        'basicSalaryBdt', 'allowancesBdt', 'deductionsBdt', 'netPayableBdt',
        'status', 'paymentDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 && data.staffId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.staffNameBn is string && data.staffNameBn.size() >= 1 && data.staffNameBn.size() <= 300 &&
      data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 100 &&
      data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 300 &&
      data.salaryMonth is string && data.salaryMonth.size() >= 2 && data.salaryMonth.size() <= 120 &&
      data.basicSalaryBdt is number && data.basicSalaryBdt >= 0 && data.basicSalaryBdt <= 5000000 &&
      data.allowancesBdt is number && data.allowancesBdt >= 0 && data.allowancesBdt <= 5000000 &&
      data.deductionsBdt is number && data.deductionsBdt >= 0 && data.deductionsBdt <= 5000000 &&
      data.netPayableBdt is number && data.netPayableBdt >= 0 && data.netPayableBdt <= 10000000 &&
      data.status is string && data.status.size() <= 40 && data.status in ['paid', 'pending'] &&
      data.paymentDate is string && data.paymentDate.size() <= 60 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidNotice(data) {
      return data.keys().hasAll([
        'titleBn', 'titleEn', 'contentBn', 'targetAudience', 'targetClass',
        'priority', 'publishDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'titleBn', 'titleEn', 'contentBn', 'targetAudience', 'targetClass',
        'priority', 'publishDate', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 400 &&
      data.titleEn is string && data.titleEn.size() <= 400 &&
      data.contentBn is string && data.contentBn.size() >= 1 && data.contentBn.size() <= 3000 &&
      data.targetAudience is string && data.targetAudience.size() <= 40 && data.targetAudience in ['all', 'guardians', 'teachers', 'residential', 'students'] &&
      data.targetClass is string && data.targetClass.size() <= 250 &&
      data.priority is string && data.priority.size() <= 40 && data.priority in ['normal', 'important', 'urgent'] &&
      data.publishDate is string && data.publishDate.size() >= 4 && data.publishDate.size() <= 60 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInstitutionSettings(data) {
      return data.keys().hasAll([
        'institutionNameBn', 'institutionNameEn', 'institutionNameAr',
        'academicYear', 'hijriYear', 'addressBn', 'phone', 'email',
        'defaultLanguage', 'activeDepartments', 'gradingSystem',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'institutionNameBn', 'institutionNameEn', 'institutionNameAr',
        'academicYear', 'hijriYear', 'addressBn', 'phone', 'email',
        'defaultLanguage', 'activeDepartments', 'gradingSystem',
        'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.institutionNameBn is string && data.institutionNameBn.size() >= 1 && data.institutionNameBn.size() <= 300 &&
      data.institutionNameEn is string && data.institutionNameEn.size() >= 1 && data.institutionNameEn.size() <= 300 &&
      data.institutionNameAr is string && data.institutionNameAr.size() <= 300 &&
      data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 100 &&
      data.hijriYear is string && data.hijriYear.size() <= 100 &&
      data.addressBn is string && data.addressBn.size() <= 500 &&
      data.phone is string && data.phone.size() <= 100 &&
      data.email is string && data.email.size() <= 200 &&
      data.defaultLanguage is string && data.defaultLanguage.size() <= 20 && data.defaultLanguage in ['bn', 'en', 'ar'] &&
