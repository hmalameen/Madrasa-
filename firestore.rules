      ]) &&
      data.keys().hasOnly([
        'guardianUid', 'guardianName', 'guardianPhone', 'guardianEmail',
        'requestedAdmissionNo', 'requestedStudentNameBn', 'relationship',
        'matchedStudentId', 'status', 'adminNotes', 'requestedDate',
