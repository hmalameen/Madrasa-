    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and role-based access configuration for madrasa portal users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "muhtamim", "teacher", "accountant", "residential_supervisor", "guardian", "student", "staff"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "suspended"]
        },
        "linkedStudentIds": { "type": "string", "maxLength": 500 },
        "assignedClasses": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "linkedStudentIds", "assignedClasses", "phone", "createdAt", "updatedAt"]
    },
