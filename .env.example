# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://portal.ummulquranmadrasa.edu.bd).
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER-SIDE ONLY: SUPER ADMIN ONE-TIME BOOTSTRAP & FIREBASE ADMIN SDK
# CRITICAL SECURITY RULE:
# - NEVER prefix any of the variables below with VITE_
# - NEVER commit real private keys or secrets to source control
# - Notice that SUPER_ADMIN_BOOTSTRAP_SECRET, FIREBASE_ADMIN_PROJECT_ID, and
#   FIREBASE_ADMIN_CLIENT_EMAIL alone are NOT sufficient to initialize the
#   Firebase Admin SDK; FIREBASE_ADMIN_PRIVATE_KEY is also mandatory.
# ==============================================================================

# 1. One-time high-entropy secret token (minimum 12 chars; 32+ chars recommended).
# Verified using constant-time comparison (crypto.timingSafeEqual) on the server.
SUPER_ADMIN_BOOTSTRAP_SECRET="REPLACE_WITH_HIGH_ENTROPY_SERVER_SIDE_SECRET"

# 2. Exact GCP / Firebase Project ID (must match firebase-applet-config.json projectId).
FIREBASE_ADMIN_PROJECT_ID="amazing-haven-348x0"

# 3. Firebase Admin Service Account email address from GCP IAM -> Service Accounts.
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@amazing-haven-348x0.iam.gserviceaccount.com"

# 4. REQUIRED FOR FIREBASE ADMIN SDK: Service Account RSA Private Key in PKCS#8 PEM format.
# Keep wrapped in double quotes with literal \n newline sequences; the server normalizes \\n -> \n.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PEM_BODY_IN_SECRET_MANAGER\n-----END PRIVATE KEY-----\n"

# 5. Optional override for named Firestore database ID (defaults to ai-studio-1b55b05f-f4f5-4207-bc43-a2855e1a028e).
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-1b55b05f-f4f5-4207-bc43-a2855e1a028e"

# 6. Optional override for the designated owner email allowed to claim Super Admin.
SUPER_ADMIN_ALLOWED_EMAIL="hmalameenemob@gmail.com"
